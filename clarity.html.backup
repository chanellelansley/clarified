                            <path d="M12 2v3m0 14v3m10-10h-3M5 12H2m16.364-7.364l-2.121 2.121M7.757 16.243l-2.121 2.121m12.728 0l-2.121-2.121M7.757 7.757L5.636 5.636"></path>
