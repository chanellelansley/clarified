                    <button class="option-suggestion-add-btn" id="option-suggestion-add">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Add
                    </button>
                    <button class="option-suggestion-dismiss" id="option-suggestion-dismiss">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <button class="btn-add-option" id="deep-add-option">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="16"></line>
                        <line x1="8" y1="12" x2="16" y2="12"></line>
                    </svg>
                    Add another path
                </button>

                <button class="btn btn-primary btn-full mt-lg" id="deep-continue-3">Continue</button>
            </div>
        </div>

        <!-- Step 4: When do you need to decide? -->
        <div class="page" id="page-deep-4">
            <div class="container">
                <button class="flow-back-btn-top" onclick="showPage('deep-3'); return false;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                    Back
                </button>

                <div class="flow-progress-indicator-centered">
                    <div class="flow-progress-dot completed"></div>
                    <div class="flow-progress-dot completed"></div>
                    <div class="flow-progress-dot completed"></div>
                    <div class="flow-progress-dot active"></div>
                    <div class="flow-progress-dot"></div>
                </div>

                <h2 class="page-title">When do you need to decide?</h2>
                <p class="text-center text-muted mb-lg">This helps us understand the pressure you're under.</p>

                <!-- Timeline Options -->
                <div class="timeline-cards-container">
                    <button class="timeline-card" data-timeline="urgent">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span>This week</span>
                    </button>
                    <button class="timeline-card" data-timeline="soon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <span>Within a month</span>
                    </button>
                    <button class="timeline-card" data-timeline="flexible">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"></path>
                        </svg>
                        <span>A few months</span>
                    </button>
                    <button class="timeline-card" data-timeline="open">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span>No deadline</span>
                    </button>
                    <button class="timeline-card" data-timeline="custom" id="timeline-custom-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                            <circle cx="8" cy="16" r="1" fill="currentColor"></circle>
                        </svg>
                        <span id="timeline-custom-label">Pick a date</span>
                    </button>
                </div>

                <!-- Date Picker (hidden by default) -->
                <div class="timeline-date-picker" id="timeline-date-picker" style="display: none;">
                    <label class="form-label">Choose your deadline</label>
                    <input type="date" id="timeline-date-input" class="input" />
                </div>

                <!-- Reminder Section -->
                <div class="timeline-reminder-section" id="timeline-reminder-section">
                    <div class="reminder-header">
                        <label class="reminder-checkbox-label">
                            <input type="checkbox" id="reminder-enabled" class="reminder-checkbox" />
                            <span class="reminder-label-text">Want a gentle nudge?</span>
                        </label>
                        <p class="reminder-sublabel">Remind me to decide</p>
                    </div>

                    <!-- Reminder Options (shown when checked) -->
                    <div class="reminder-options" id="reminder-options" style="display: none;">
                        <div class="reminder-method-toggle">
                            <button class="reminder-method-btn active" data-method="email">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                                Email
                            </button>
                            <button class="reminder-method-btn" data-method="text">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                                    <line x1="12" y1="18" x2="12.01" y2="18"></line>
                                </svg>
                                Text
                            </button>
                        </div>

                        <!-- Email confirmation -->
                        <div class="reminder-email-info" id="reminder-email-info">
                            <p class="text-sm text-muted">We'll send a reminder to your account email</p>
                        </div>

                        <!-- Phone number input (shown when text is selected) -->
                        <div class="reminder-phone-input" id="reminder-phone-input" style="display: none;">
                            <label class="form-label">Phone number</label>
                            <input type="tel" id="reminder-phone" class="input" placeholder="+1 (555) 123-4567" />
                            <p class="text-sm text-muted mt-xs">We'll only use this for decision reminders</p>
                        </div>
                    </div>
                </div>

                <!-- Auto-detected category -->
                <p class="text-sm text-center text-tertiary mt-lg" id="deep-category-display"></p>

                <button class="btn btn-primary btn-full mt-lg" id="deep-continue-4">Continue</button>
            </div>
        </div>

        <!-- Step 5: Values -->
        <div class="page" id="page-deep-5">
            <div class="container">
                <div class="decision-flow-header">
                    <button class="flow-back-btn" onclick="showPage('deep-4'); return false;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                        Back
                    </button>
                    <div class="flow-progress-text">Step 5 of 7</div>
                </div>

                <div class="reframe-headline">
                    <h2 class="page-title">What matters most to you?</h2>
                    <div class="info-tooltip">
                        <svg class="info-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M12 16v-4"></path>
                            <path d="M12 8h.01"></path>
                        </svg>
                        <div class="tooltip-content">
                            Research shows decisions aligned with your values lead to higher satisfaction — even when outcomes aren't perfect. This is the foundation of values-based decision making.
                        </div>
                    </div>
                </div>

                <!-- Category Context Text -->
                <p class="values-category-text" id="deep-values-header">
                    Common priorities for relationship decisions
                </p>

                <!-- Selection Counter -->
                <div class="values-counter" id="values-counter">
                    <span class="counter-text">0 selected</span>
                </div>

                <!-- Values Grid -->
                <div class="values-grid" id="deep-values-chips">
                    <!-- Values will be populated dynamically based on category -->
                </div>

                <!-- Helper Text -->
                <p class="values-helper-text">
                    Pick 3-4 values · These will shape your recommendation
                </p>

                <button class="btn btn-primary btn-full mt-xl" id="deep-continue-5" disabled>Continue</button>
            </div>
        </div>

        <!-- Step 6: Assumptions -->
        <div class="page" id="page-deep-6">
            <div class="container">
                <div class="decision-flow-header">
                    <button class="flow-back-btn" onclick="showPage('deep-5'); return false;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                        Back
                    </button>
                    <div class="flow-progress-text">Step 6 of 7</div>
                </div>

                <div class="reframe-headline">
                    <h2 class="page-title">What do you expect to happen?</h2>
                    <div class="info-tooltip">
                        <svg class="info-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M12 16v-4"></path>
                            <path d="M12 8h.01"></path>
                        </svg>
                        <div class="tooltip-content">
                            Surfacing assumptions helps avoid confirmation bias — the tendency to only see evidence that supports what we already believe.
                        </div>
                    </div>
                </div>

                <p class="text-center text-muted mb-xl">Your expectations reveal hidden assumptions</p>

                <!-- Option 1 Future Card -->
                <div class="assumption-card assumption-option-1">
                    <div class="assumption-card-header">
                        <div class="assumption-letter">A</div>
                        <div class="assumption-option-name" id="deep-assumption-option1-label-short">Option 1</div>
                    </div>
                    <p class="assumption-question">What happens next?</p>
                    <textarea
                        id="deep-assumption-option1"
                        class="assumption-textarea"
                        rows="3"
                        placeholder="I expect..."></textarea>
                </div>

                <!-- Option 2 Future Card -->
                <div class="assumption-card assumption-option-2">
                    <div class="assumption-card-header">
                        <div class="assumption-letter">B</div>
                        <div class="assumption-option-name" id="deep-assumption-option2-label-short">Option 2</div>
                    </div>
                    <p class="assumption-question">What happens next?</p>
                    <textarea
                        id="deep-assumption-option2"
                        class="assumption-textarea"
                        rows="3"
                        placeholder="I expect..."></textarea>
                </div>

                <!-- Uncertainty Card (Dashed Border) -->
                <div class="assumption-card assumption-uncertain">
                    <div class="assumption-uncertain-header">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        <h3>What might you be wrong about?</h3>
                    </div>
                    <p class="assumption-helper">The things we don't see coming often matter most</p>
                    <textarea
                        id="deep-assumption-misjudge"
                        class="assumption-textarea"
                        rows="3"
                        placeholder="I'm not sure about..."></textarea>
                </div>

                <p class="text-sm text-center text-muted mt-md">It's okay to guess — this helps surface hidden expectations</p>

                <button class="btn btn-primary btn-full mt-xl" id="deep-continue-6">Continue</button>
            </div>
        </div>

        <!-- Step 7: What Makes This Difficult -->
        <div class="page" id="page-deep-7">
            <div class="container">
                <div class="decision-flow-header">
                    <button class="flow-back-btn" onclick="showPage('deep-6'); return false;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                        Back
                    </button>
                    <div class="flow-progress-text">Step 7 of 7</div>
                </div>
                <div class="reframe-headline">
                    <h2 class="page-title">What's making this hard?</h2>
                    <div class="info-tooltip">
                        <svg class="info-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M12 16v-4"></path>
                            <path d="M12 8h.01"></path>
                        </svg>
                        <div class="tooltip-content">
                            Naming your fears reduces their power. Research shows acknowledging challenges leads to clearer thinking.
                        </div>
                    </div>
                </div>

                <p class="text-center text-muted mb-xl">Select the main challenges you're facing</p>

                <div class="chip-grid" id="deep-difficulty-chips">
                    <!-- Challenges will be populated dynamically based on category -->
                </div>

                <button class="btn btn-primary btn-full mt-xl" id="deep-continue-7">Continue</button>
            </div>
        </div>

        <!-- Step 8: Confirmation Summary -->
        <div class="page" id="page-deep-8">
            <div class="container">
                <div class="decision-flow-header">
                    <button class="flow-back-btn" onclick="showPage('deep-7'); return false;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                        Back
                    </button>
                    <div class="flow-progress-text">Review</div>
                </div>
                <h2 class="page-title">Here's what I heard</h2>
                <p class="text-center text-muted mb-xs">Does this capture your situation?</p>

                <!-- Narrative Intro -->
                <div class="summary-narrative mb-lg">
                    <p class="narrative-decision">You're deciding: <span id="narrative-decision-text"></span></p>
                    <p class="narrative-context" id="narrative-context-text"></p>
                </div>

                <div id="deep-summary-cards">
                    <!-- Card 1: Decision & Options -->
                    <div class="card mb-md">
                        <h3 class="summary-section-header">Decision & Options</h3>
                        <p class="text-md mb-xs" id="summary-decision"></p>
                        <p class="text-sm text-muted mb-xs">Category: <span id="summary-category"></span></p>
                        <p class="text-sm text-muted mb-sm">Timeline: <span id="summary-timeline"></span></p>
                        <p class="text-sm text-muted mb-xs">Options:</p>
                        <ul id="summary-options" class="text-sm" style="margin-left: 20px;"></ul>
                    </div>

                    <!-- Card 2: What matters -->
                    <div class="card mb-md">
                        <h3 class="summary-section-header">What matters most to you</h3>
                        <div id="summary-values" class="summary-tags-container"></div>
                    </div>

                    <!-- Card 3: Concerns -->
                    <div class="card mb-md">
                        <h3 class="summary-section-header">What's making this hard</h3>
                        <div id="summary-challenges" class="summary-tags-container"></div>
                        <p class="text-sm mt-sm" id="summary-challenge-detail" style="color: var(--sage-600);"></p>
                    </div>

                    <!-- Card 4: Assumptions -->
                    <div class="card mb-md">
                        <h3 class="summary-section-header">Assumptions you're making</h3>
                        <div id="summary-assumptions"></div>
                    </div>
                </div>

                <div class="button-group">
                    <button class="btn btn-secondary btn-full" id="deep-adjust-summary">Let me adjust</button>
                    <button class="btn btn-primary btn-full" id="deep-confirm-summary">That's right</button>
                </div>
            </div>
        </div>

        <!-- Step 9: Significance Assessment -->
        <div class="page" id="page-deep-9">
            <div class="container">
                <div class="decision-flow-header">
                    <button class="flow-back-btn" onclick="showPage('deep-8'); return false;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                        Back
                    </button>
                    <div class="flow-progress-text">Final Step</div>
                </div>

                <h2 class="page-title">How significant is this decision to you?</h2>
                <p class="text-center text-muted mb-xl">This helps us adjust the depth and tone of your recommendation</p>

                <div class="significance-stack" id="significance-cards">
                    <!-- Life-changing -->
                    <div class="significance-card" data-significance="life-changing">
                        <div class="significance-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"></path>
                            </svg>
                        </div>
                        <div class="significance-content">
                            <h3>Life-changing</h3>
                            <p>Irreversible or major impact on your life</p>
                        </div>
                        <div class="significance-checkmark">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                    </div>

                    <!-- Significant -->
                    <div class="significance-card" data-significance="significant">
                        <div class="significance-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M8 12h8M12 8v8"></path>
                            </svg>
                        </div>
                        <div class="significance-content">
                            <h3>Significant</h3>
                            <p>Meaningful impact with some flexibility</p>
                        </div>
                        <div class="significance-checkmark">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                    </div>

                    <!-- Small -->
                    <div class="significance-card" data-significance="small">
                        <div class="significance-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                        </div>
                        <div class="significance-content">
                            <h3>Small</h3>
                            <p>Low stakes and easily reversible</p>
                        </div>
                        <div class="significance-checkmark">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                    </div>
                </div>

                <p class="text-sm text-center text-muted mt-lg">Life-changing decisions get deeper analysis and more cautious messaging</p>

                <button class="btn btn-primary btn-full mt-xl" id="deep-continue-9">Continue</button>
            </div>
        </div>

        <!-- Deep Results -->
        <div class="page" id="page-deep-results">
            <div class="container">
                <!-- Page Header -->
                <h1 class="page-title">Here's what makes sense for you</h1>
                <p class="page-subtitle" id="results-decision-title"></p>

                <!-- Disclaimer Banner (shown if user continued past disclaimer) -->
                <div class="results-disclaimer-banner" id="results-disclaimer" style="display: none;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                    <p>
                        <strong>Reminder:</strong> This is not <span id="disclaimer-type">medical</span> advice.
                        Please consult a qualified professional before making this decision.
                    </p>
                </div>

                <!-- Similar Decisions (Above Tabs) -->
                <div class="card similar-decisions-card mb-lg" id="similar-decisions-card" style="display: none;">
                    <div class="similar-decisions-header">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="similar-icon">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <div class="similar-header-text">
                            <h3 class="similar-title">You've been here before</h3>
                            <p class="similar-subtitle" id="similar-decisions-subtitle">2 similar decisions found</p>
                        </div>
                        <button class="similar-collapse-btn">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="18 15 12 9 6 15"></polyline>
                            </svg>
                        </button>
                    </div>
                    <div id="similar-decisions-list" class="similar-decisions-list">
                        <!-- Similar decisions will be populated dynamically -->
                    </div>
                </div>

                <!-- TABS (3 ONLY) -->
                <div class="tabs mb-lg">
                    <button class="tab active" data-tab="why-wins">Why this wins</button>
                    <button class="tab" data-tab="compare">Compare options</button>
                    <button class="tab" data-tab="tradeoffs">Tradeoffs & risks</button>
                </div>

                <!-- TAB CONTENT -->

                <!-- Why This Wins Tab -->
                <div class="tab-content active" id="tab-why-wins">
                    <!-- Your Best Move Card -->
                    <div class="recommendation-card">
                        <div class="loading-state" id="top-rec-loading">
                            <div class="spinner"></div>
                            <p>Analyzing your decision...</p>
                        </div>
                        <div id="top-rec-content" style="display: none;">
                            <div class="recommendation-header">
                                <span class="recommendation-label">YOUR BEST MOVE</span>
                                <span class="best-fit-badge">Best fit for you</span>
                            </div>
                            <h2 class="recommendation-title" id="top-rec-option"></h2>
                            <div class="recommendation-explanation" id="top-rec-context"></div>
                        </div>
                    </div>

                    <!-- How Confident Is This Accordion - EXPANDED BY DEFAULT -->
                    <div class="accordion mt-md" id="confidence-accordion">
                        <button class="accordion-toggle" onclick="toggleAccordion('confidence')">
                            <span>How sure is this?</span>
                            <div class="accordion-preview-group">
                                <span class="confidence-preview" id="confidence-preview">This one's obvious</span>
                                <span class="accordion-chevron">▼</span>
                            </div>
                        </button>
                        <div class="accordion-content">
                            <!-- Confidence bar -->
                            <div class="confidence-meter">
                                <div class="confidence-bar">
                                    <div class="confidence-fill" id="confidence-fill"></div>
                                    <div class="confidence-marker" id="confidence-marker"></div>
                                </div>
                                <div class="confidence-labels">
                                    <span>Toss-up</span>
                                    <span>No-brainer</span>
                                </div>
                            </div>
                            <p class="confidence-summary" id="confidence-summary">Loading...</p>

                            <!-- Tipping points -->
                            <h4 class="tipping-title">What would change this?</h4>
                            <div id="tipping-cards">
                                <!-- Populated dynamically -->
                            </div>
                        </div>
                    </div>

                    <!-- Reversibility Accordion -->
                    <div class="accordion collapsed" id="reversibility-accordion">
                        <button class="accordion-toggle" onclick="toggleAccordion('reversibility')">
                            <span>Reversibility</span>
                            <div class="accordion-preview-group">
                                <span class="reversibility-preview" id="reversibility-preview">Moderate</span>
                                <span class="accordion-chevron">▼</span>
                            </div>
                        </button>
                        <div class="accordion-content">
                            <div class="reversibility-visual">
                                <div class="reversibility-scale">
                                    <div class="reversibility-fill" id="reversibility-fill" style="width: 50%"></div>
                                    <div class="reversibility-marker" id="reversibility-marker" style="left: 50%"></div>
                                </div>
                                <div class="reversibility-labels">
                                    <span>One-way door</span>
                                    <span>Easy to undo</span>
                                </div>
                            </div>
                            <p class="reversibility-explanation" id="reversibility-explanation">This decision can be partially reversed, but some effects may be lasting.</p>
                        </div>
                    </div>

                    <!-- Worth Asking Yourself Accordion -->
                    <div class="accordion collapsed" id="reflection-accordion">
                        <button class="accordion-toggle" onclick="toggleAccordion('reflection')">
                            <span>Worth asking yourself</span>
                            <span class="accordion-chevron">▼</span>
                        </button>
                        <div class="accordion-content">
                            <ul class="reflection-list" id="reflection-questions">
                                <!-- Populated dynamically -->
                            </ul>
                        </div>
                    </div>

                    <!-- Get Input From Others -->
                    <div class="mt-lg mb-xl" style="display: flex; justify-content: center;">
                        <a href="#" class="share-pill-link" onclick="openShareModal(); return false;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                            <span>Get input from others</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-icon">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </a>
                    </div>
                </div>

                <!-- Compare Options Tab -->
                <div class="tab-content" id="tab-compare">
                    <!-- Dot Table Comparison -->
                    <div class="loading-state" id="compare-loading">
                        <div class="spinner"></div>
                        <p>Building comparison...</p>
                    </div>
                    <div id="compare-content" style="display: none;">
                        <div class="compare-table-wrapper" id="compare-table-wrapper">
                            <!-- Populated dynamically -->
                        </div>
                        <p class="compare-footnote">Scores reflect how each option maps to your stated priorities</p>
                    </div>
                </div>

                <!-- Tradeoffs & Risks Tab (Vertically Stacked) -->
                <div class="tab-content" id="tab-tradeoffs">
                    <div class="tradeoffs-cards-vertical">
                        <!-- Gains Card -->
                        <div class="tradeoff-card-v gain">
                            <div class="tradeoff-header-v">
                                <div class="icon-circle green">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                </div>
                                <h4>What you gain</h4>
                            </div>
                            <div class="loading-state" id="gains-loading">
                                <div class="spinner-sm"></div>
                            </div>
                            <ul id="gains-content" class="tradeoff-list-v" style="display: none;">
                                <!-- Gains will be populated dynamically -->
                            </ul>
                        </div>

                        <!-- Tradeoffs Card -->
                        <div class="tradeoff-card-v tradeoff">
                            <div class="tradeoff-header-v">
                                <div class="icon-circle amber">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                </div>
                                <h4>What you trade off</h4>
                            </div>
                            <div class="loading-state" id="tradeoffs-loading">
                                <div class="spinner-sm"></div>
                            </div>
                            <ul id="tradeoffs-content" class="tradeoff-list-v" style="display: none;">
                                <!-- Tradeoffs will be populated dynamically -->
                            </ul>
                        </div>

                        <!-- Risks Card -->
                        <div class="tradeoff-card-v risk">
                            <div class="tradeoff-header-v">
                                <div class="icon-circle red">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                        <line x1="12" y1="9" x2="12" y2="13"></line>
                                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                    </svg>
                                </div>
                                <h4>What could go wrong</h4>
                            </div>
                            <div class="loading-state" id="risks-loading">
                                <div class="spinner-sm"></div>
                            </div>
                            <ul id="risks-list" class="tradeoff-list-v" style="display: none;">
                                <!-- Risks will be populated dynamically -->
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Bottom CTA -->
                <div class="button-group mt-xl" style="display: flex; justify-content: center;">
                    <button class="btn btn-primary" onclick="showPage('decision-type'); return false;">
                        Make another decision
                    </button>
                </div>
            </div>
        </div>

        <!-- Additional pages will be added here -->

    </div>

    <!-- Share Modal -->
    <div class="modal" id="share-modal">
        <div class="modal-overlay" onclick="closeShareModal()"></div>
        <div class="modal-content share-modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Share this decision</h3>
                <button class="modal-close" onclick="closeShareModal()">&times;</button>
            </div>
            <div class="modal-body">
                <p class="modal-subtitle">Get perspectives from people you trust. They'll see your decision context and can provide input.</p>

                <div class="share-toggles">
                    <div class="share-toggle-item">
                        <div class="share-toggle-info">
                            <label class="share-toggle-label">Allow collaborators to comment</label>
                            <p class="share-toggle-description">People can add their thoughts and suggestions</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" id="allow-comments" checked>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>

                    <div class="share-toggle-item">
                        <div class="share-toggle-info">
                            <label class="share-toggle-label">Share anonymously</label>
                            <p class="share-toggle-description">Your name won't be visible to collaborators</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" id="share-anonymous">
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>

                <button class="btn btn-primary btn-full share-generate-btn" onclick="generateShareLink()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                    </svg>
                    Generate share link
                </button>

                <div class="share-link-container" id="share-link-container" style="display: none;">
                    <label class="share-link-label">Share link</label>
                    <div class="share-link-input-group">
                        <input type="text" class="share-link-input" id="share-link-input" readonly value="https://clarity.app/share/abc123def">
                        <button class="btn-copy" onclick="copyShareLink()">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                            </svg>
                            Copy
                        </button>
                    </div>
                    <p class="share-link-note">Anyone with this link can view and comment on this decision</p>
                </div>

                <!-- Global Disclaimer Footer -->
                <div class="global-disclaimer">
                    <p>Clarified helps you think through decisions — it's not a substitute for professional advice. For medical, financial, or legal decisions, please consult a qualified professional.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Upgrade Modal -->
    <div class="modal" id="upgrade-modal">
        <div class="modal-overlay" onclick="closeUpgradeModal()"></div>
        <div class="modal-content modal-content-md">
            <div class="modal-header">
                <h3 class="modal-title" id="upgrade-modal-title">Upgrade to continue</h3>
                <button class="modal-close" onclick="closeUpgradeModal()">&times;</button>
            </div>
            <div class="modal-body">
                <p class="modal-subtitle" id="upgrade-modal-message">Choose how you'd like to proceed</p>

                <!-- Upgrade Options -->
                <div class="upgrade-options" id="upgrade-options">
                    <!-- Pro Subscription Option -->
                    <div class="upgrade-option-card" id="upgrade-option-pro" style="display: none;">
                        <div class="upgrade-option-header">
                            <div>
                                <h4 class="upgrade-option-title">Pro Plan</h4>
                                <div class="upgrade-option-price">$8/month</div>
                            </div>
                            <div class="upgrade-option-badge">Best value</div>
                        </div>
                        <ul class="upgrade-option-features">
                            <li>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                Unlimited Everyday decisions
                            </li>
                            <li>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                2 Life decisions/month
                            </li>
                            <li>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                What-if scenarios
                            </li>
                            <li>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                Decision Profile & insights
                            </li>
                            <li>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                Outcome tracking
                            </li>
                        </ul>
                        <button class="btn btn-primary btn-full" onclick="upgradeToPro(); return false;">
                            Upgrade to Pro
                        </button>
                    </div>

                    <!-- Pay-per-use Option -->
                    <div class="upgrade-option-card" id="upgrade-option-payperuse" style="display: none;">
                        <div class="upgrade-option-header">
                            <div>
                                <h4 class="upgrade-option-title">One Life Decision</h4>
                                <div class="upgrade-option-price">$5</div>
                            </div>
                        </div>
                        <ul class="upgrade-option-features">
                            <li>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                One Life decision
                            </li>
                            <li>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                What-if scenarios included
                            </li>
                            <li class="upgrade-feature-muted">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                                No Decision Profile
                            </li>
                            <li class="upgrade-feature-muted">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                                No outcome tracking
                            </li>
                        </ul>
                        <button class="btn btn-secondary btn-full" onclick="buyLifeDecision(); return false;">
                            Buy for $5
                        </button>
                    </div>
                </div>

                <p class="text-xs text-muted text-center" style="margin-top: 1rem;">
                    Secure checkout powered by Stripe
                </p>
            </div>
        </div>
    </div>

    <!-- ============================================
         SAFETY MODALS
         ============================================ -->

    <!-- Crisis Modal (Self-Harm) -->
    <div class="modal crisis-modal" id="crisis-modal">
        <div class="modal-content crisis-content">
            <div class="crisis-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
            </div>

            <h2>We're here for you</h2>

            <p class="crisis-message">
                It sounds like you might be going through a really difficult time.
                You don't have to face this alone — please reach out to someone who can help.
            </p>

            <div class="crisis-resources">
                <a href="tel:988" class="crisis-link primary">
                    <div class="crisis-link-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                    </div>
                    <div class="crisis-link-text">
                        <strong>988 Suicide & Crisis Lifeline</strong>
                        <span>Call or text 988 — available 24/7</span>
                    </div>
                </a>

                <a href="sms:741741&body=HOME" class="crisis-link">
                    <div class="crisis-link-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                    </div>
                    <div class="crisis-link-text">
                        <strong>Crisis Text Line</strong>
                        <span>Text HOME to 741741</span>
                    </div>
                </a>

                <a href="https://findahelpline.com" target="_blank" class="crisis-link">
                    <div class="crisis-link-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                    </div>
                    <div class="crisis-link-text">
                        <strong>International Resources</strong>
                        <span>Find a helpline in your country</span>
                    </div>
                </a>
            </div>

            <p class="crisis-note">
                Clarified isn't equipped to help with this kind of pain, but these people are trained to help and want to hear from you.
            </p>

            <button class="btn btn-secondary" onclick="closeCrisisModal()">
                I understand
            </button>
        </div>
    </div>

    <!-- Harm to Others Warning Modal -->
    <div class="modal warning-modal" id="harm-modal">
        <div class="modal-content">
            <div class="warning-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                </svg>
            </div>

            <h2>We can't help with this</h2>

            <p>Clarified can't provide guidance on decisions that might harm others. If you're feeling intense anger or having thoughts of hurting someone, please consider speaking with a mental health professional.</p>

            <a href="https://www.samhsa.gov/find-help/national-helpline" target="_blank" class="resource-link">
                SAMHSA National Helpline: 1-800-662-4357
            </a>

            <button class="btn btn-secondary" onclick="closeHarmModal()">
                I understand
            </button>
        </div>
    </div>

    <!-- Illegal Activity Warning Modal -->
    <div class="modal warning-modal" id="illegal-modal">
        <div class="modal-content">
            <div class="warning-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                </svg>
            </div>

            <h2>We can't help with this</h2>

            <p>Clarified can't provide guidance on decisions involving illegal activities. We're here to help with legitimate life decisions.</p>

            <button class="btn btn-secondary" onclick="closeIllegalModal()">
                I understand
            </button>
        </div>
    </div>

    <!-- Minor Warning Modal -->
    <div class="modal warning-modal" id="minor-modal">
        <div class="modal-content">
            <div class="warning-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
            </div>

            <h2>We can't help with this</h2>

            <p>Clarified can't provide guidance on relationships involving minors. If you have concerns, please speak with a trusted adult or counselor.</p>

            <button class="btn btn-secondary" onclick="closeMinorModal()">
                I understand
            </button>
        </div>
    </div>

    <!-- Medical Disclaimer Modal -->
    <div class="modal disclaimer-modal" id="medical-disclaimer-modal">
        <div class="modal-content">
            <div class="disclaimer-icon medical">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                </svg>
            </div>

            <h2>This sounds like a medical decision</h2>

            <p>Clarified can help you think through life decisions, but medical decisions should involve a healthcare professional who knows your specific situation.</p>

            <p class="disclaimer-advice">We recommend speaking with your doctor, therapist, or another qualified healthcare provider before making changes to your treatment.</p>

            <div class="disclaimer-actions">
                <button class="btn btn-secondary" onclick="closeDisclaimerModal('medical')">
                    Go back
                </button>
                <button class="btn btn-primary" onclick="continueWithDisclaimer('medical')">
                    Continue anyway
                </button>
            </div>

            <p class="disclaimer-note">By continuing, you acknowledge this is not medical advice.</p>
        </div>
    </div>

    <!-- Financial Disclaimer Modal -->
    <div class="modal disclaimer-modal" id="financial-disclaimer-modal">
        <div class="modal-content">
            <div class="disclaimer-icon financial">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
            </div>

            <h2>This sounds like a financial decision</h2>

            <p>Clarified can help you think through life decisions, but investment and financial decisions should involve a qualified financial advisor.</p>

            <p class="disclaimer-advice">Consider consulting a certified financial planner (CFP) or registered investment advisor (RIA) before making significant financial decisions.</p>

            <div class="disclaimer-actions">
                <button class="btn btn-secondary" onclick="closeDisclaimerModal('financial')">
                    Go back
                </button>
                <button class="btn btn-primary" onclick="continueWithDisclaimer('financial')">
                    Continue anyway
                </button>
            </div>

            <p class="disclaimer-note">By continuing, you acknowledge this is not financial advice.</p>
        </div>
    </div>

    <!-- Legal Disclaimer Modal -->
    <div class="modal disclaimer-modal" id="legal-disclaimer-modal">
        <div class="modal-content">
            <div class="disclaimer-icon legal">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                    <line x1="9" y1="9" x2="9.01" y2="9"></line>
                    <line x1="15" y1="9" x2="15.01" y2="9"></line>
                </svg>
            </div>

            <h2>This sounds like a legal decision</h2>

            <p>Clarified can help you think through life decisions, but legal matters should involve an attorney who can provide advice specific to your situation.</p>

            <p class="disclaimer-advice">Consider consulting a licensed attorney before making decisions that could have legal implications.</p>

            <div class="disclaimer-actions">
                <button class="btn btn-secondary" onclick="closeDisclaimerModal('legal')">
                    Go back
                </button>
                <button class="btn btn-primary" onclick="continueWithDisclaimer('legal')">
                    Continue anyway
                </button>
            </div>

            <p class="disclaimer-note">By continuing, you acknowledge this is not legal advice.</p>
        </div>
    </div>

    <!-- Site Footer -->
    <footer class="site-footer">
        <a href="#" onclick="showPage('methodology'); return false;">The Method</a>
        <a href="#" onclick="showPage('account'); return false;">Account</a>
        <a href="https://clarified.app/privacy" target="_blank">Privacy</a>
    </footer>

    <!-- Supabase JS Library -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <!-- App Scripts -->
    <script src="supabase-client.js"></script>
    <script src="payments.js"></script>
    <script src="clarity.js"></script>
    <script src="whatif-scenarios.js"></script>
</body>
</html>
