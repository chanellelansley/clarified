<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clarified — Stop overthinking</title>
    <link rel="icon" type="image/svg+xml" href="favicon.svg">
    <link rel="icon" type="image/x-icon" href="favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600&family=Newsreader:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="clarity.css">
</head>
<body>
    <!-- Global Navigation -->
    <nav class="nav" id="global-nav" style="display: none;">
        <div class="nav-container">
            <a href="#" class="nav-logo" onclick="showPage('decision-type'); return false;">
                <svg class="logo-dot" width="12" height="12" viewBox="0 0 12 12">
                    <circle cx="6" cy="6" r="6" fill="#418F6F"/>
                </svg>
                <span class="logo-wordmark">Clarified</span>
            </a>
            <div class="nav-links">
                <a href="#" class="nav-link" data-page="decisions" onclick="showPage('decisions'); return false;">
                    <span>Decisions</span>
                </a>
                <a href="#" class="nav-link nav-icon" data-page="account" onclick="showPage('account'); return false;" aria-label="Account">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="4"></circle>
                        <path d="M20 21a8 8 0 1 0-16 0"></path>
                    </svg>
                </a>
            </div>
        </div>
    </nav>

    <!-- App Container -->
    <div class="app" id="app">

        <!-- LOGIN / SIGNUP PAGE -->
        <div class="page active" id="page-login">
            <div class="login-split-layout">
                <!-- Left Section: Branding (Desktop only) -->
                <div class="login-branding-section">
                    <!-- Subtle dot pattern background -->
                    <div class="login-branding-pattern"></div>

                    <div class="login-branding-content">
                        <svg class="logo-dot-large" width="24" height="24" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="12" fill="white"/>
                        </svg>
                        <h1 class="login-branding-logo">Clarified</h1>
                        <p class="login-branding-tagline">Stop overthinking.</p>
                    </div>
                </div>

                <!-- Right Section: Form -->
                <div class="login-form-section">
                    <div class="login-form-container">
                        <!-- Mobile: Show logo centered at top -->
                        <div class="login-mobile-header">
                            <svg class="logo-dot-large" width="24" height="24" viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="12" fill="#418F6F"/>
                            </svg>
                            <div class="logo-large">Clarified</div>
                        </div>

                        <!-- Form Card -->
                        <div class="login-card-premium">
                            <!-- Founding Member Callout (only shown on signup) -->
                            <div class="founding-member-callout" id="founding-member-callout" style="display: none;">
                                <span class="callout-icon">⭐</span>
                                <span class="callout-text">Join as a Founding Member</span>
                            </div>

                            <h2 id="auth-header" class="login-form-title">Welcome back</h2>

                            <form class="login-form" id="auth-form">
                                <div class="form-group-premium">
                                    <label for="email" class="form-label-premium">Email</label>
                                    <input type="email" id="email" class="input-premium" placeholder="you@example.com" required>
                                </div>

                                <div class="form-group-premium">
                                    <label for="password" class="form-label-premium">Password</label>
                                    <input type="password" id="password" class="input-premium" placeholder="••••••••" required>
                                    <a href="#" class="forgot-password-link" id="forgot-password-link" onclick="showPasswordResetModal(); return false;">Forgot password?</a>
                                </div>

                                <button type="submit" class="btn-premium btn-full" id="auth-submit-btn">Sign In</button>
                            </form>

                            <p class="login-toggle-text">
                                <span id="auth-toggle-text">Don't have an account?</span> <a href="#" id="auth-toggle-link" class="login-link">Sign up</a>
                            </p>

                            <div class="login-footer-premium">
                                Free to start · No credit card required
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- DECISION TYPE SELECTION PAGE -->
        <!--
            PRICING MODEL:

            FREE:
            - 5 Everyday decisions / month
            - 1 Life decision free trial (requires credit card)
            - No what-if scenarios
            - No Decision Profile
            - No outcome tracking

            PRO ($8/month):
            - Unlimited Everyday decisions
            - 2 Life decisions / month
            - What-if scenarios included
            - Full Decision Profile
            - Outcome tracking

            PAY-PER-USE:
            - $5 per Life decision (no subscription)
            - Includes what-if scenarios for that decision
            - No Profile or outcome tracking
        -->
        <div class="page" id="page-decision-type">
            <!-- Top Navigation -->
            <nav class="top-nav-premium">
                <div class="top-nav-container">
                    <div class="top-nav-logo">
                        <svg class="logo-dot" width="12" height="12" viewBox="0 0 12 12">
                            <circle cx="6" cy="6" r="6" fill="#418F6F"/>
                        </svg>
                        <span class="logo-wordmark">Clarified</span>
                    </div>
                    <div class="top-nav-links">
                        <a href="#" class="top-nav-link" data-page="dashboard" title="Home">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                            </svg>
                            <span>Home</span>
                        </a>
                        <a href="#" class="top-nav-link" data-page="decisions" title="Decisions">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="9 11 12 14 22 4"></polyline>
                                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                            </svg>
                            <span>Decisions</span>
                        </a>
                        <a href="#" class="top-nav-link" data-page="account" title="Account">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            <span>Account</span>
                        </a>
                    </div>
                </div>
            </nav>

            <div class="container-premium">
                <div class="page-header-premium">
                    <h1>What kind of decision is this?</h1>
                </div>

                <div class="decision-type-grid-simple">
                    <!-- Everyday Card -->
                    <div class="decision-type-card-simple" data-type="quick">
                        <div class="decision-card-icon-simple">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                            </svg>
                        </div>
                        <h2 class="decision-card-title-simple">Everyday</h2>
                        <p class="decision-card-description-simple">Quick stuff — what to eat, which task first, small purchases</p>
                        <div class="decision-card-duration">
                            <svg class="duration-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            ~30 seconds
                        </div>
                    </div>

                    <!-- Life Card -->
                    <div class="decision-type-card-simple decision-card-life" data-type="deep">
                        <div class="decision-card-badge-popular">Most popular</div>
                        <div class="decision-card-icon-simple">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <circle cx="12" cy="12" r="6"></circle>
                                <circle cx="12" cy="12" r="2"></circle>
                            </svg>
                        </div>
                        <h2 class="decision-card-title-simple">Life</h2>
                        <p class="decision-card-description-simple">Big stuff — career, relationships, moves, major commitments</p>
                        <div class="decision-card-duration">
                            <svg class="duration-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            ~2 minutes
                        </div>
                        <!-- Locked state (hidden by default, shown when trial used) -->
                        <div class="decision-card-locked" style="display: none;">
                            <svg class="lock-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <span class="locked-text">Free trial used · <a href="#" class="locked-link" onclick="showPaymentOptions(); return false;">$5</a> or <a href="#" class="locked-link" onclick="showPage('account'); return false;">upgrade to Pro</a></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- DECISIONS PAGE -->
        <div class="page" id="page-decisions">
            <div class="container container-wide">
                <!-- Header with streak and CTA -->
                <div class="decisions-header">
                    <div class="streak-inline" id="streak-inline" style="display: none;">
                        <span class="streak-icon">🔥</span>
                        <span class="streak-text"><span class="streak-count" id="streak-count">0</span> day streak</span>
                    </div>
                    <button class="btn btn-primary" onclick="showPage('decision-type'); return false;">
                        What's on your mind?
                    </button>
                </div>

                <!-- Decision Profile Card -->
                <div class="decision-profile-card" id="decision-profile-card">
                    <!-- Populated dynamically by JS -->
                </div>

                <!-- Decisions List Container -->
                <div class="decisions-list" id="decisions-list">
                    <!-- Populated dynamically by JS -->
                </div>

                <!-- Empty State -->
                <div class="decisions-empty-state" id="decisions-empty-state" style="display: none;">
                    <div class="empty-state">
                        <div class="empty-icon">○</div>
                        <h2>No decisions yet</h2>
                        <p>Start with something on your mind.<br>Clarified will help you think it through.</p>
                        <button class="btn btn-primary" onclick="showPage('decision-type'); return false;">
                            What's on your mind?
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL: Record Your Decision -->
        <div class="modal" id="record-decision-modal">
            <div class="modal-overlay" onclick="closeRecordDecisionModal()"></div>
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title">Record outcome</h2>
                    <button class="modal-close" onclick="closeRecordDecisionModal()">&times;</button>
                </div>

                <div class="modal-body">
                    <p class="modal-subtitle" id="record-decision-title">Should I accept the job offer in Seattle?</p>

                    <!-- Field 1: What did you decide? -->
                    <div class="form-group">
                        <label class="form-label outcome-label-with-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 11l3 3L22 4"></path>
                                <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
                            </svg>
                            What did you decide?
                        </label>
                        <div class="outcome-option-buttons" id="record-option-buttons">
                            <!-- Options will be dynamically inserted here -->
                            <!-- Example: -->
                            <!-- <button class="outcome-option-btn">I accepted the offer</button> -->
                            <!-- <button class="outcome-option-btn">I declined the offer</button> -->
                        </div>
                        <button class="outcome-option-btn outcome-option-other" onclick="selectOtherOption(); return false;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="16"></line>
                                <line x1="8" y1="12" x2="16" y2="12"></line>
                            </svg>
                            Something else
                        </button>
                        <button class="outcome-option-btn outcome-option-undecided" onclick="selectStillDeciding(); return false;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                            </svg>
                            Still deciding
                        </button>
                    </div>

                    <!-- Field 2: How's it going? -->
                    <div class="form-group" id="reflection-group">
                        <label class="form-label outcome-label-with-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"></path>
                            </svg>
                            How's it going?
                        </label>
                        <textarea class="textarea" id="reflection-textarea" rows="3" placeholder="Any reflections, regrets, or lessons learned?"></textarea>
                        <div class="text-xs text-muted mt-xs">Optional — but helpful to look back on</div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-text" onclick="closeRecordDecisionModal()">Cancel</button>
                    <button class="btn btn-primary" onclick="saveOutcome(); return false;" id="save-outcome-btn">Save</button>
                </div>
            </div>
        </div>

        <!-- MODAL: Quick Check-in (Redesigned) -->
        <div class="modal" id="quick-checkin-modal">
            <div class="modal-overlay" onclick="closeQuickCheckInModal()"></div>
            <div class="modal-content modal-content-md checkin-modal-warm">
                <div class="modal-header">
                    <h2 class="modal-title checkin-title-warm">How did it turn out?</h2>
                    <button class="modal-close" onclick="closeQuickCheckInModal()">&times;</button>
                </div>

                <div class="modal-body">
                    <!-- Decision Context -->
                    <div class="checkin-context" id="checkin-context">
                        <p class="checkin-decision-title" id="quick-checkin-title">End a long-term friendship</p>
                        <p class="checkin-decision-meta" id="quick-checkin-meta">You decided to end the friendship · 1 month ago</p>
                    </div>

                    <!-- Response Options -->
                    <div class="checkin-options-grid" id="checkin-options-grid">
                        <button class="checkin-option-card" data-response="positive" onclick="selectCheckInResponse('positive')">
                            <div class="checkin-option-emoji">😊</div>
                            <div class="checkin-option-primary">It was right</div>
                            <div class="checkin-option-secondary">I'd do it again</div>
                        </button>

                        <button class="checkin-option-card" data-response="mixed" onclick="selectCheckInResponse('mixed')">
                            <div class="checkin-option-emoji">🤔</div>
                            <div class="checkin-option-primary">Mixed feelings</div>
                            <div class="checkin-option-secondary">Pros and cons</div>
                        </button>

                        <button class="checkin-option-card" data-response="regret" onclick="selectCheckInResponse('regret')">
                            <div class="checkin-option-emoji">😔</div>
                            <div class="checkin-option-primary">I have regrets</div>
                            <div class="checkin-option-secondary">Wish I'd chosen differently</div>
                        </button>

                        <button class="checkin-option-card" data-response="early" onclick="selectCheckInResponse('early')">
                            <div class="checkin-option-emoji">⏳</div>
                            <div class="checkin-option-primary">Too early</div>
                            <div class="checkin-option-secondary">Still unfolding</div>
                        </button>
                    </div>

                    <!-- Follow-up Question (hidden initially) -->
                    <div class="checkin-followup" id="checkin-followup" style="display: none;">
                        <label class="checkin-followup-label">What's one thing you learned?</label>
                        <textarea class="checkin-followup-input" id="checkin-learning" rows="3" placeholder="Optional..."></textarea>
                        <button class="btn btn-primary btn-full mt-md" onclick="submitQuickCheckIn()">Submit reflection</button>
                    </div>

                    <!-- Thank You Message (hidden initially) -->
                    <div class="checkin-thanks" id="checkin-thanks" style="display: none;">
                        <div class="checkin-thanks-icon">✓</div>
                        <p class="checkin-thanks-text">Thanks for reflecting. This helps improve your future recommendations.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL: Password Reset -->
        <div class="modal" id="password-reset-modal">
            <div class="modal-overlay" onclick="closePasswordResetModal()"></div>
            <div class="modal-content modal-content-sm">
                <div class="modal-header">
                    <h2 class="modal-title">Reset your password</h2>
                    <button class="modal-close" onclick="closePasswordResetModal()">&times;</button>
                </div>

                <div class="modal-body">
                    <p class="modal-subtitle">We'll send you an email with a link to reset your password.</p>

                    <div class="form-group">
                        <label class="form-label">Email address</label>
                        <input type="email" class="input-premium" id="reset-email" placeholder="you@example.com" required>
                    </div>

                    <div id="reset-success-message" style="display: none; padding: 12px; background: #E8F2ED; border-radius: 8px; color: #2D4A3E; margin-top: 16px;">
                        ✓ Check your email for a password reset link
                    </div>

                    <div id="reset-error-message" style="display: none; padding: 12px; background: #FEE; border-radius: 8px; color: #C00; margin-top: 16px;"></div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-text" onclick="closePasswordResetModal()">Cancel</button>
                    <button class="btn btn-primary" onclick="handlePasswordReset(); return false;" id="reset-password-btn">Send reset link</button>
                </div>
            </div>
        </div>

        <!-- LOADING: Full Page (Deep Clarity) -->
        <div class="loading-overlay" id="deep-clarity-loader" style="display: none;">
            <div class="loading-content">
                <svg class="loading-dot" width="48" height="48" viewBox="0 0 48 48">
                    <circle cx="24" cy="24" r="24" fill="#418F6F"/>
                </svg>
                <h2 class="loading-title">Analyzing your decision...</h2>
                <p class="loading-subtext" id="loading-subtext">Weighing your values...</p>
            </div>
        </div>

        <!-- ACCOUNT PAGE -->
        <div class="page" id="page-account">
            <div class="container">
                <h1 class="page-title">Account</h1>

                <!-- Current Plan Card -->
                <div class="card" id="current-plan-card">
                    <div class="plan-header">
                        <div class="plan-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                <path d="M2 17l10 5 10-5"/>
                                <path d="M2 12l10 5 10-5"/>
                            </svg>
                        </div>
                        <div class="plan-details">
                            <h3 class="plan-name" id="plan-name">Loading...</h3>
                            <p class="plan-subtitle" id="plan-subtitle">Please wait</p>
                            <div class="founding-member-badge" id="founding-member-badge" style="display: none;">
                                <span class="badge-icon">⭐</span>
                                <span class="badge-text">Founding Member</span>
                            </div>
                            <div class="beta-access-note" id="beta-access-note" style="display: none;">
                                Beta access — all features unlocked
                            </div>
                        </div>
                        <!-- Manage Subscription button (for Pro users) -->
                        <button class="btn btn-text" id="manage-subscription-btn" style="display: none;" onclick="manageSubscription(); return false;">
                            Manage subscription
                        </button>
                    </div>

                    <div class="plan-usage">
                        <div class="usage-item">
                            <div class="usage-row">
                                <span class="usage-label">Everyday decisions</span>
                                <span class="usage-value" id="everyday-usage">Loading...</span>
                            </div>
                            <div class="progress-bar-usage">
                                <div class="progress-fill-usage" id="everyday-progress" style="width: 0%"></div>
                            </div>
                        </div>
                        <div class="usage-item">
                            <div class="usage-row">
                                <span class="usage-label">Life decisions</span>
                                <span class="usage-value" id="life-usage">Loading...</span>
                            </div>
                            <div class="progress-bar-usage">
                                <div class="progress-fill-usage" id="life-progress" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Subscription Management (for Pro users) -->
                    <div class="subscription-management" id="subscription-management" style="display: none;">
                        <p>You're on the Pro plan. Next billing date: <span id="next-billing-date">—</span></p>
                        <button class="btn-text-danger" onclick="cancelSubscription()">Cancel subscription</button>
                    </div>
                </div>

                <!-- Upgrade to Pro Card -->
                <div class="card upgrade-card" id="upgrade-card" style="display: none;">
                    <h3 class="card-heading">Upgrade to Clarified Pro</h3>

                    <!-- Pricing Card -->
                    <div class="pricing-cards">
                        <div class="pricing-card pricing-card-recommended">
                            <div class="pricing-card-header">
                                <h4 class="pricing-card-title">Pro Plan</h4>
                                <div class="pricing-card-price">
                                    <span class="price-amount">$8</span>
                                    <span class="price-period">/month</span>
                                </div>
                            </div>
                            <button class="btn btn-primary btn-full" onclick="upgradeToPro(); return false;">
                                Upgrade to Pro
                            </button>
                        </div>
                    </div>

                    <!-- Pro Benefits -->
                    <div class="pro-benefits-grid">
                        <div class="benefit-item">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>Unlimited Everyday</span>
                        </div>
                        <div class="benefit-item">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>2 Life decisions/month ($3 each additional)</span>
                        </div>
                        <div class="benefit-item">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>Full analysis & tracking</span>
                        </div>
                        <div class="benefit-item">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>Save all decisions</span>
                        </div>
                        <div class="benefit-item">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>Outcome tracking</span>
                        </div>
                        <div class="benefit-item">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"></polyline>
